.venv/
__pycache__/
*.pyc
.DS_Store
.localized
.cache/

# ``data/raw/*`` not ``data/raw/`` -- git's negation rules cannot
# re-include a file once its parent dir has been excluded, so we glob
# the children instead and then un-ignore the synthetic Codex/Cursor
# subdirs, which are project-shipped test data (not user uploads).
data/raw/*
!data/raw/codex/
!data/raw/cursor/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

.python-version-local
.env
.env.*
!.env.example

# Scratch directories Codex / Claude Code agents may write into when
# we test them against this repo. They live at the project root only
# because that's the cwd we run agents from -- nothing here is a
# project artifact.
/Codex/
/.claude/
/.codex/

dist/
build/
*.egg-info/

.pytest_cache/
.ruff_cache/
.mypy_cache/
